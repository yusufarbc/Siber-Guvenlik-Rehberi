      "type": "action",  
      "name": "E-posta Analizi ve IOC Çıkarımı",  
      "description": "Şüpheli mail dosyasından header, linkler ve eklerin MD5/SHA256 değerlerini parse eder",  
      "commands": \[  
        {  
          "type": "python",  
          "command": "import email\_parser; email\_parser.extract\_artifacts()"  
        }  
