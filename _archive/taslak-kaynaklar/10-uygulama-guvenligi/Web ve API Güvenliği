#### **Gelişmiş GraphQL Güvenlik Konfigürasyon Örneği**

Aşağıdaki TypeScript kod bloğu, bir Node.js ortamında Apollo Server kullanarak hem maksimum derinlik sınırını, hem yukarıda belirtilen dinamik karmaşıklık maliyet hesabını, hem de üretim ortamında introspection engelleme kurallarını tek bir yapıda entegre etmektedir:

TypeScript  
// server.ts \- Gelişmiş Kurumsal GraphQL Güvenlik Altyapısı  
import { ApolloServer } from '@apollo/server';  
import { startStandaloneServer } from '@apollo/server/standalone';  
import depthLimit from 'graphql-depth-limit';  
import { getComplexity, simpleEstimator, fieldExtensionsEstimator } from 'graphql-query-complexity';  
import { NoSchemaIntrospectionCustomRule, GraphQLError } from 'graphql';  
import { typeDefs, resolvers } from './schema';

const MAX\_ALLOWED\_DEPTH \= 6;  
const MAX\_ALLOWED\_COMPLEXITY \= 500;

const server \= new ApolloServer({  
  typeDefs,  
  resolvers,  
  // Güvenlik doğrulama kuralları (Validation Rules)  
  validationRules: \[  
    // 1\. Aşırı yuvalanmış döngüsel sorguları engellemek için derinlik limiti  
    depthLimit(MAX\_ALLOWED\_DEPTH),  
      
    // 2\. Üretim ortamında şema keşfini engellemek için Introspection kuralı  
    ...(process.env.NODE\_ENV \=== 'production' ? \[NoSchemaIntrospectionCustomRule\] : \[\]),  
      
    // 3\. Dinamik sorgu maliyet ve karmaşıklık analizi entegrasyonu  
    (context) \=\> {  
      const { document, variables } \= context;  
      try {  
        const calculatedComplexity \= getComplexity({  
          schema: server.schema,  
          query: document,  
          variables,  
          estimators: \[  
            // Şema içindeki directive'lerden (@complexity) maliyetleri okur  
            fieldExtensionsEstimator(),  
            // Varsayılan taban maliyet hesaplayıcısı  
            simpleEstimator({ defaultComplexity: 1 })  
          \]  
        });

        // Hesaplanan maliyet kurumsal limiti aşarsa sorgu iptal edilir  
        if (calculatedComplexity \> MAX\_ALLOWED\_COMPLEXITY) {  
          throw new GraphQLError(  
            \`Güvenlik Engeli: Sorgu çok maliyetli. Limit: ${MAX\_ALLOWED\_COMPLEXITY}, Hesaplanan: ${calculatedComplexity}\`,  
            {  
              extensions: {  
                code: 'QUERY\_TOO\_COMPLEX',  
                calculatedComplexity,  
                maxAllowed: MAX\_ALLOWED\_COMPLEXITY,  
                suggestions: \[  
                  'Sayfalama limitlerini düşürün (örn: first: 10)',  
                  'Sorgulanan ilişkisel alan sayısını azaltın',  
                  'Sorguyu birden fazla küçük parçaya bölün'  
                \]  
              }  
            }  
          );  
        }  
      } catch (error) {  
        if (error instanceof GraphQLError) throw error;  
        throw new GraphQLError('Sorgu analizi sırasında beklenmeyen bir hata oluştu.');  
      }  
      return \[\];  
    }  
  \]  
});

