\# config/config.yml  
models:  
  \- type: main  
    engine: openai  
    model: gpt-4o-mini \[cite: 29, 30\]  
  \- type: self\_check\_input  
    engine: self-hosted  
    model: my-org/custom-safety-model \[cite: 31\]

