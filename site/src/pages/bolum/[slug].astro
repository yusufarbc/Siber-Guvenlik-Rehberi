---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { parts, site } from "../../data/outline";

export function getStaticPaths() {
  return parts.map((part) => ({
    params: { slug: part.slug },
    props: { part },
  }));
}

const { part } = Astro.props;
const currentIndex = parts.findIndex((item) => item.slug === part.slug);
const previous = currentIndex > 0 ? parts[currentIndex - 1] : null;
const next = currentIndex < parts.length - 1 ? parts[currentIndex + 1] : null;
---

<BaseLayout
  title={`${part.partId} ${part.title} | ${site.title}`}
  description={`${part.chapterTitle} bolumu icin ${part.partId} basligi.`}
>
  <section class="detail-card reveal">
    <div class="breadcrumbs">
      <a href="/">Ana Sayfa</a>
      <span>/</span>
      <a href="/bolum/">Bolumler</a>
      <span>/</span>
      <span>{part.partId}</span>
    </div>
    <div>
      <div class="part-meta">Bolum {part.chapterId}</div>
      <h1>{part.partId} {part.title}</h1>
      <p class="section-sub">{part.chapterTitle}</p>
    </div>
    <ul class="inline-list">
      {part.bullets.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
    <div class="next-prev">
      {previous ? (
        <a class="button secondary" href={`/bolum/${previous.slug}`}>
          ← {previous.partId}
        </a>
      ) : null}
      {next ? (
        <a class="button" href={`/bolum/${next.slug}`}>
          {next.partId} →
        </a>
      ) : null}
    </div>
  </section>
</BaseLayout>
