---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { chapters, site } from "../../data/outline";
---

<BaseLayout
  title={`Bolumler | ${site.title}`}
  description="Kitabin 14 ana bolum ve 31 alt basliktan olusan tam listesi."
>
  <section class="reveal">
    <h1 class="section-title">Bolumler</h1>
    <p class="section-sub">
      31 parcalik uretim listesi, bolumlere gore gruplanmis sekilde.
    </p>
    <div class="chapter-grid">
      {chapters.map((chapter) => (
        <article class="chapter-card" id={chapter.anchor}>
          <div>
            <div class="part-meta">Bolum {chapter.id}</div>
            <h3>{chapter.title}</h3>
            <p>{chapter.summary}</p>
          </div>
          <ul class="part-list">
            {chapter.parts.map((part) => (
              <li>
                <a href={`/bolum/${part.slug}`}>
                  <span>{part.id} {part.title}</span>
                  <span class="part-meta">Detay</span>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
