---
import BaseLayout from "../layouts/BaseLayout.astro";
import { chapters, site } from "../data/outline";
---

<BaseLayout title={site.title} description={site.description}>
	<section class="hero reveal">
		<h1>{site.title}</h1>
		<p>{site.tagline}</p>
		<div class="hero-actions">
			<a class="button" href="/bolum/">Bolumlere Git</a>
			<a class="button secondary" href="#manifesto">Manifestoyu Oku</a>
		</div>
	</section>

	<section id="manifesto" class="reveal delay-1">
		<h2 class="section-title">Manifesto</h2>
		<p class="section-sub">
			Bu kitap; mimari, entegrasyon ve operasyon katmanlarini tek bir guvenlik
			omurgasinda birlestiren bir yol haritasidir. Her bolum, sahada uygulanan
			pratiklere ve denetlenebilir sureclere odaklanir.
		</p>
		<div class="chapter-grid">
			<article class="chapter-card">
				<h3>Guvenlik Mimari Disiplini</h3>
				<p>
					Temel prensiplerden baslayip, kurumsal risk ve uyum boyutlarini
					katmanlar halinde ele alir.
				</p>
			</article>
			<article class="chapter-card">
				<h3>Operasyonel Gerceklik</h3>
				<p>
					SOC, SIEM ve olay mudahale pratiklerini yalnizca teori degil, isletim
					kabiliyeti olarak ele alir.
				</p>
			</article>
			<article class="chapter-card">
				<h3>Olceklenebilir Yolculuk</h3>
				<p>
					31 parcali uretim listesiyle ekiplerin bolum bolum ilerlemesini
					saglar.
				</p>
			</article>
		</div>
	</section>

	<section id="yolculuk" class="reveal delay-2">
		<h2 class="section-title">Yol Haritasi</h2>
		<p class="section-sub">
			Her bolum, ilgili alt basliklara ayrilmis 31 parcali bir uretim listesiyle
			ilerler.
		</p>
		<div class="chapter-grid">
			{chapters.map((chapter) => (
				<article class="chapter-card">
					<div>
						<div class="part-meta">Bolum {chapter.id}</div>
						<h3>{chapter.title}</h3>
						<p>{chapter.summary}</p>
					</div>
					<ul class="part-list">
						{chapter.parts.map((part) => (
							<li>
								<a href={`/bolum/${part.slug}`}>
									<span>{part.id} {part.title}</span>
									<span class="part-meta">Detay</span>
								</a>
							</li>
						))}
					</ul>
				</article>
			))}
		</div>
	</section>
</BaseLayout>
